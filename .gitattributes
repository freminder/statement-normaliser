# Your global core.autocrlf=true would hand you CRLF working copies on Windows
# and LF on Linux/CI. For a project whose whole job is parsing CSV bytes, that
# is a difference you do not want between your machine and the test runner.
# Store and check out LF everywhere, on every platform.
* text=auto eol=lf

# Fixtures are inputs under test. Never let Git rewrite them.
examples/*.csv -text

# Generated by uv; keep diffs honest and never merge it by hand.
uv.lock -diff linguist-generated=true
